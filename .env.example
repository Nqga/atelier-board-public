# Exemple pour Docker Compose. Ne contient aucun secret.
# Pour un lancement Node direct, remplacer DATA_DIR par ./data.
PORT=3000
HOST=0.0.0.0
DATA_DIR=/data

# En production, utiliser l'origine HTTPS publique sans chemin ni fragment.
PUBLIC_URL=http://localhost:3000

# Activer seulement derrière un proxy HTTPS de confiance inaccessible en direct.
TRUST_PROXY=0

# Entiers strictement positifs. Une configuration invalide bloque le démarrage.
# Projets créés et encore stockés par identité invitée (créateur d'origine).
MAX_BOARDS_PER_GUEST=20
# État Yjs complet et fichiers d'images. Une unité vaut 1 Mio = 1 048 576 octets.
MAX_BOARD_STORAGE_MB=100
MAX_TOTAL_STORAGE_MB=1024
# Ces limites ne représentent pas toute l'occupation du disque SQLite/métadonnées.
