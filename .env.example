# Exemple pour Docker Compose. Ne contient aucun secret.
# Pour HTTPS avec Caddy, utiliser .env.production.example et deploy/compose.https.yml.
# Pour un lancement Node direct, remplacer DATA_DIR par ./data.
PORT=3000
BIND_ADDRESS=0.0.0.0
HOST=0.0.0.0
DATA_DIR=/data

# Accès HTTP direct : http://ADRESSE_DU_SERVEUR:3000.
# Vide : le serveur utilise l'adresse et le port de chaque requête.
# On peut aussi fixer exactement cette origine, par ex. http://192.0.2.10:3000.
# Ne pas garder localhost si les utilisateurs viennent d'autres machines.
PUBLIC_URL=

# Activer seulement derrière un proxy HTTPS de confiance inaccessible en direct.
TRUST_PROXY=0

# Entiers strictement positifs. Une configuration invalide bloque le démarrage.
# Projets créés et encore stockés par identité invitée (créateur d'origine).
MAX_BOARDS_PER_GUEST=20
# État Yjs complet et fichiers d'images. Une unité vaut 1 Mio = 1 048 576 octets.
MAX_BOARD_STORAGE_MB=100
MAX_TOTAL_STORAGE_MB=1024
# Ces limites ne représentent pas toute l'occupation du disque SQLite/métadonnées.

# Limites de charge : entiers strictement positifs, adaptés aux ressources du serveur.
MAX_CONNECTIONS=500
MAX_CONNECTIONS_PER_BOARD=50
MAX_CONNECTIONS_PER_USER=12
MAX_ACTIVE_BOARDS=100
MAX_IDLE_BOARDS=100
SESSION_CREATIONS_PER_MINUTE=120
INVITATION_JOINS_PER_MINUTE=300
WEBSOCKET_CONNECTIONS_PER_MINUTE=300
