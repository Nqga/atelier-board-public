# Profil HTTP privé derrière un tunnel VPN déjà configuré.
# Générer .env.vpn avec : bash scripts/configure-vpn.sh <IPv4-locale-du-serveur> [port]
# Ne pas utiliser une adresse distante ni l'adresse de la passerelle du tunnel.
VPN_BIND_ADDRESS=
PORT=3000
VPN_PUBLIC_URL=

# Les autres paramètres (quotas, capacité, COMPOSE_PROJECT_NAME) restent dans .env.
# Charger .env puis .env.vpn avec les options --env-file de Docker Compose.
