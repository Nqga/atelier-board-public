# Copy to .env.production and set your real public domain (without protocol/path).
# The DNS A/AAAA records must point to the server; ports 80 and 443 must be open.
DOMAIN=board.example.com

# The HTTPS Compose overlay derives PUBLIC_URL=https://DOMAIN and TRUST_PROXY=1.
# Preserve your existing Compose project name when upgrading from Docker v2.
# COMPOSE_PROJECT_NAME=atelier-board-public

# Positive integers. Storage units are binary MiB (1 MiB = 1,048,576 bytes).
MAX_BOARDS_PER_GUEST=20
MAX_BOARD_STORAGE_MB=100
MAX_TOTAL_STORAGE_MB=1024
